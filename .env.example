# OpenClaw Docker Configuration
# ================================

# Gateway token (auto-generated by setup.sh)
OPENCLAW_GATEWAY_TOKEN=

# Data directories (relative to docker-compose.yaml)
OPENCLAW_CONFIG_DIR=./data/config
OPENCLAW_WORKSPACE_DIR=./data/workspace

# Allow dashboard auth over plain HTTP (default: false)
# Only set to true if you have a TLS-terminating reverse proxy in front
# OPENCLAW_ALLOW_INSECURE_AUTH=false

# ================================
# OpenClaw config variables (optional)
# ================================
# These variables can be referenced as ${VAR_NAME} in openclaw.json.
# If you use them, store the actual values in ./data/config/.env
# (not this file). See README.md for details.
#
# TELEGRAM_BOT_TOKEN=
# GATEWAY_TOKEN=
# OPENAI_API=
# NOTION_API=

# ================================
# Developer tools (optional)
# ================================
# Set to true and rebuild to install git, ssh-client, and gh CLI in the container.
# Needed for the developer agent persona.
# INSTALL_DEV_TOOLS=false

# ================================
# Developer agent credentials (optional)
# ================================
# Required only if using the developer agent persona.
# Store actual values in ./data/config/.env, not here.
#
# GITHUB_TOKEN=
# ANTHROPIC_API_KEY=
